{
  "name": "apex-launcher",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "main.cjs",
  "description": "Apex game launcher — library, store, Minecraft & mods, stats, health.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "app": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "dist": "vite build && electron-builder --win",
    "release": "vite build && electron-builder --win --publish always"
  },
  "build": {
    "appId": "com.apex.launcher",
    "productName": "Apex Launcher",
    "files": [
      "dist/**/*",
      "*.cjs",
      "package.json",
      "build/tray.png",
      "build/icon.png"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "shortcutName": "Apex Launcher",
      "deleteAppDataOnUninstall": false,
      "artifactName": "Apex-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Apex-Launcher-${version}-portable.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Sxjrdn",
        "repo": "apex-launcher"
      }
    ],
    "asar": true
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "discord-rpc": "^4.0.1",
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "electron": "^34.2.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "vite": "^6.1.0",
    "wait-on": "^8.0.2"
  }
}
